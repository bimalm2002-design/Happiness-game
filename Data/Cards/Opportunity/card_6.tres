id = 6
title = "රබර් ඉඩම (Rubber Land)"
card_type = "Opportunity"
description = "ලීසිං ණය ගෙවා ගැනීමට අපහසු වූ ත්‍රීරෝද රථයක් හිමි Taxi රියදුරෙකු ඔහුගේ ත්‍රීරෝද රථය විකිණීමට ගැනුම්කරුවෙකු සොයයි. ඔහු එය විකුණුවහොත් රැකියාව අහිමි වන බැවින් Rent (කුලී) පදනම මත නැවත ඔහුටම ලබා දිය හැක."
cost = 15000
down_payment = 3000
cashflow = 3000
penalty = 0
