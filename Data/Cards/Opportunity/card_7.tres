title = "තේ ඉඩම (Tea Estate)"
card_type = "Opportunity"
description = "විශ්‍රාමයාමට ආසන්න රියදුරෙක් සිය වෑන් රථය විකිණීමට ගැනුම්කරුවකු සොයයි. මෑතක සිට පාසල් ළමුන් ප්‍රවාහනය කරන බස් රථවල ඉඩකඩ අඩු බැවින් ළමුන් තෙරපෙමින් ගමන් කරන බව අසන්නට ලැබේ."
cost = 25000
down_payment = 5000
cashflow = 4500
penalty = 0
price_per_share = 0
buttons = ["invest", "pass"]
