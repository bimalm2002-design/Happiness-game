card_type = "Flash"
description = "ඔබ ආයෝජනය කරන ලද පරිගණක මෘදුකාංගය සංවර්ධන කටයුතු අවසන් වී එම තරුණ පිරිස එම මෘදුකාංගයේ බුද්ධිමය දේපළ බලපත්‍රය විකුණා, ඔබගේ ආයෝජනයට අදාල කොටස ඔබට ගෙනාවෙත් ලබා දෙන ලදී."
cost = 0
down_payment = 0
cashflow = 0
penalty = 0
