title = "කිරිකෝකා දන්තාලේප (Kirikoka Toothpaste)"
card_type = "Stock"
description = "කිරිකොකා දන්තාලේප සමාගම ආදායම් බදු දෙපාර්තමේන්තුවේ නිලධාරියෙකුට අල්ලස් දුන්නා යයි චෝදනා මත අධිකරණයෙන් නඩු පවරා ඇත. කොටස් මිල සීඝ්‍රයෙන් පහළ වැටී ඇත."
cost = 0
down_payment = 0
cashflow = 0
penalty = 0
price_per_share = 5
buttons = ["buy", "sell", "pass"]
financial_statement_effect = "Adds/Updates Asset 'Kirikoka'"
cash_ledger_effect = "Deducts (Qty * Price) on buy / Adds on sell"
